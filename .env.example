# ==============================================================================
# OpenCode Free Fleet & Swarm - Environment Variables Example
# ==============================================================================
# Set these as User Environment Variables on your machine:
#   PowerShell (Windows):
#     [Environment]::SetEnvironmentVariable("OPENROUTER_API_KEY", "your-key-here", "User")
#     [Environment]::SetEnvironmentVariable("GROQ_API_KEY", "your-key-here", "User")
#     [Environment]::SetEnvironmentVariable("MISTRAL_API_KEY", "your-key-here", "User")
#
#   Bash / Zsh (Mac / Linux):
#     export OPENROUTER_API_KEY="your-key-here"
#     export GROQ_API_KEY="your-key-here"
#     export MISTRAL_API_KEY="your-key-here"
# ==============================================================================

# OpenRouter API Key (Provides 14+ free models & free router)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Groq API Key (Free tier: LLaMA 3.3 70B, GPT-OSS, Qwen models)
GROQ_API_KEY=gsk_your-key-here

# Mistral API Key (Free credits plan: Codestral & Mistral Small)
MISTRAL_API_KEY=your-key-here
