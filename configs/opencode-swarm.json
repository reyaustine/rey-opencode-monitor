{
  "$schema": "https://unpkg.com/opencode-swarm@7.162.1/opencode-swarm.schema.json",
  "agents": {
    "architect": {
      "model": "google/gemini-2.5-pro",
      "reasoning": {
        "effort": "low"
      }
    },
    "coder": {
      "model": "openrouter/deepseek/deepseek-chat",
      "reasoning": {
        "effort": "medium"
      }
    },
    "test_engineer": {
      "model": "openrouter/deepseek/deepseek-chat",
      "reasoning": {
        "effort": "high"
      }
    },
    "reviewer": {
      "model": "google/gemini-2.5-pro",
      "reasoning": {
        "effort": "high"
      }
    },
    "explorer": {
      "model": "google/gemini-2.5-flash"
    },
    "sme": {
      "model": "openrouter/deepseek/deepseek-chat",
      "reasoning": {
        "effort": "medium"
      }
    },
    "researcher": {
      "model": "google/gemini-2.5-flash"
    },
    "critic": {
      "model": "google/gemini-2.5-pro",
      "reasoning": {
        "effort": "high"
      }
    },
    "docs": {
      "model": "google/gemini-2.5-flash"
    },
    "docs_design": {
      "model": "google/gemini-2.5-flash"
    },
    "designer": {
      "model": "opencode/minimax-m2.5-free"
    },
    "critic_sounding_board": {
      "model": "google/gemini-2.5-pro",
      "reasoning": {
        "effort": "high"
      }
    },
    "critic_drift_verifier": {
      "model": "google/gemini-2.5-pro",
      "reasoning": {
        "effort": "high"
      }
    },
    "critic_hallucination_verifier": {
      "model": "google/gemini-2.5-pro",
      "reasoning": {
        "effort": "high"
      }
    },
    "critic_oversight": {
      "model": "google/gemini-2.5-pro",
      "reasoning": {
        "effort": "high"
      }
    },
    "critic_architecture_supervisor": {
      "model": "google/gemini-2.5-pro",
      "reasoning": {
        "effort": "high"
      }
    },
    "critic_finding_validator": {
      "model": "google/gemini-2.5-pro",
      "reasoning": {
        "effort": "high"
      }
    },
    "curator_init": {
      "model": "google/gemini-2.5-flash"
    },
    "curator_phase": {
      "model": "google/gemini-2.5-flash"
    },
    "curator_postmortem": {
      "model": "google/gemini-2.5-flash"
    },
    "curator_consolidation": {
      "model": "google/gemini-2.5-flash"
    },
    "skill_improver": {
      "model": "opencode/big-pickle"
    },
    "spec_writer": {
      "model": "openrouter/google/gemma-4-31b-it:free",
      "reasoning": {
        "effort": "medium"
      }
    }
  },
  "max_iterations": 2,
  "execution_mode": "fast",
  "turbo_mode": true,
  "block_destructive_commands": false,
  "repo_graph": {
    "enabled": false
  },
  "curator": {
    "init_enabled": false,
    "postmortem_enabled": false
  },
  "gates": {
    "syntax_check": {
      "enabled": false
    },
    "placeholder_scan": {
      "enabled": false
    },
    "sast_scan": {
      "enabled": false
    },
    "sbom_generate": {
      "enabled": false
    }
  },
  "phase_complete": {
    "policy": "warn",
    "require_docs": false
  }
}