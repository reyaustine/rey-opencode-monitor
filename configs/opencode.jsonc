{
  "$schema": "https://opencode.ai/config.json",
  // Free-only setup. ONLY these providers are enabled; every other provider
  // (including any credentials stored via /connect) is ignored.
  "enabled_providers": ["kilo", "opencode", "openrouter", "groq", "mistral", "huggingface"],
  "provider": {
    // No-key free providers (smoke-tested 2026-09-10, cost 0).
    "kilo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kilo Code (free, no key)",
      "options": {
        "baseURL": "https://api.kilo.ai/api/gateway/v1"
      },
      "whitelist": ["kilo-auto/free"]
    },
    // Built-in opencode provider (free Zen models).
    "opencode": {
      "whitelist": [
        "big-pickle",
        "ling-3.0-flash-fin-free",
        "mimo-v2.5-free",
        "muse-spark-1.2-contributor-free",
        "muse-spark-1.3-contributor-free",
        "nemotron-3-ultra-free",
        "nemotron-3.5-lightning-free"
      ]
    },
    // Key-based providers below NEVER store raw keys here. Set fresh keys as
    // user environment variables (or via /connect) AFTER revoking any key
    // that was pasted into chat. Unset env var = empty string = disabled.
    // Groq IDs below are the Free Plan models from Groq's rate-limits docs.
    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "groq",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "whitelist": [
        "openai/gpt-oss-120b",
        "openai/gpt-oss-20b",
        "openai/gpt-oss-safeguard-20b",
        "qwen/qwen3.6-27b",
        "qwen/qwen3.8-27b"
      ],
      "models": {
        "llama-3.3-70b-versatile": {
          "name": "llama-3.3-70b-versatile"
        }
      }
    },
    // google DISABLED 2026-09-10: every Gemini model fails via opencode right
    // now (2.5 retired; 3.5 hangs; 3.6/flash-latest server errors - the SDK
    // still targets the old generateContent API). Key stays in env.
    // Re-enable by adding "google" to enabled_providers with current IDs.
    // Mistral Free plan covers usage via $10/mo API credits (metered, not
    // zero-cost). Retired devstral-small-2512 removed per Mistral lifecycle docs.
    "mistral": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mistral (free credits)",
      "options": {
        "baseURL": "https://api.mistral.ai/v1",
        "apiKey": "{env:MISTRAL_API_KEY}"
      },
      "whitelist": ["codestral-latest", "mistral-small-4"]
    },
    // OpenRouter free models provider.
    "openrouter": {
      "name": "OpenRouter (free models)",
      "whitelist": [
        "openrouter/free",
        "nvidia/nemotron-3.5-lightning:free",
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "nvidia/nemotron-3-super-120b-a12b:free",
        "google/gemma-4-31b-it:free",
        "google/gemma-4-26b-a4b-it:free",
        "inclusionai/ling-3.0-flash-fin:free",
        "inclusionai/ling-3.0-flash-sante:free",
        "cohere/north-mini-code:free",
        "poolside/laguna-xs-2.1:free",
        "poolside/laguna-s-2.1:free",
        "nex-agi/nex-n2.5-pro:free",
        "liquid/lfm-2.5-2.6b:free",
        "thinkingmachines/inkling:free"
      ]
    }
    // huggingface is a built-in provider: do NOT add a custom block with a
    // guessed endpoint. Connect a fresh fine-grained token via /connect
    // (inference.serverless.write permission) after revoking the exposed one.
  },
  "disabled_providers": [],
  "agent": {
    "orchestrator": {
      "mode": "all",
      "model": "openrouter/openrouter/free",
      "description": "Lead Project Manager. Coordinates tasks and delegates to specialized agents.",
      "prompt": "You are the Lead Project Manager. Delegate tasks to specialized agents using @mention: @coder (coding/refactoring), @explorer (quick edits/CSS), @architect (system design), @reviewer (code review/QA), @critic (critical analysis), @tester (testing), @researcher (research), @docs (documentation), @designer (UI/UX design). Do NOT write massive code blocks yourself — delegate and synthesize."
    },
    "coder": {
      "mode": "all",
      "model": "openrouter/cohere/north-mini-code:free",
      "description": "Specialist for complex algorithmic code generation, refactoring, and logic.",
      "prompt": "You are a senior developer. Write clean, exact, production-ready code. No placeholders."
    },
    "explorer": {
      "mode": "all",
      "model": "openrouter/inclusionai/ling-3.0-flash-fin:free",
      "description": "Fast explorer for quick patches, CSS tweaks, UI updates, and surgical file edits.",
      "prompt": "You are a rapid-execution developer. Make precise, minimal changes. Speed over verbosity."
    },
    "architect": {
      "mode": "all",
      "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "description": "Heavyweight agent for architecture design, deep repository understanding, and system design."
    },
    "tester": {
      "mode": "all",
      "model": "openrouter/nvidia/nemotron-3.5-lightning:free",
      "description": "Writes unit tests, integration tests, and validates edge cases. Specialist for TDD and QA."
    },
    "reviewer": {
      "mode": "all",
      "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
      "description": "Thorough code reviewer and QA verifier. Validates logic, catches regressions, and checks edge cases."
    },
    "critic": {
      "mode": "all",
      "model": "openrouter/liquid/lfm-2.5-2.6b:free",
      "description": "Critical analysis agent for evaluating architecture decisions, finding edge-case flaws, and stress-testing plans."
    },
    "researcher": {
      "mode": "all",
      "model": "openrouter/google/gemma-4-31b-it:free",
      "description": "Research agent for investigating libraries, APIs, best practices, and gathering context."
    },
    "docs": {
      "mode": "all",
      "model": "openrouter/poolside/laguna-xs-2.1:free",
      "description": "Writes and maintains developer documentation, READMEs, API docs, and inline code comments."
    },
    "designer": {
      "mode": "all",
      "model": "openrouter/thinkingmachines/inkling:free",
      "description": "UI/UX design agent. Creates component designs, layout plans, and visual specifications."
    }
  }
}
