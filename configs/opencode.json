{
  "$schema": "https://opencode.ai/config.json",
  "model": "gemini/gemini-3.6-flash",
  "small_model": "mistral/codestral-latest",
  "instructions": [
    "~/.config/opencode/instructions/delegation.md"
  ],
  "enabled_providers": [
    "gemini",
    "kilo",
    "lmstudio",
    "mistral",
    "opencode",
    "openrouter"
  ],
  "provider": {
    "gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Google AI Studio (Gemini Free)",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai",
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "whitelist": [
        "gemini-3.6-flash",
        "gemini-3.5-flash-lite",
        "gemini-3.1-flash-lite",
        "gemini-3-flash-preview",
        "gemini-flash-lite-latest",
        "gemini-flash-latest"
      ],
      "models": {
        "gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash"
        },
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite"
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite"
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview"
        },
        "gemini-flash-lite-latest": {
          "name": "Gemini Flash Lite Latest"
        },
        "gemini-flash-latest": {
          "name": "Gemini Flash Latest"
        }
      }
    },
    "kilo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kilo Code (free, no key)",
      "options": {
        "baseURL": "https://api.kilo.ai/api/gateway/v1"
      },
      "whitelist": [
        "kilo-auto/free",
        "nex-agi/nex-n2.5-mini:free",
        "nex-agi/nex-n2.5-pro:free",
        "poolside/laguna-s-2.1:free",
        "stepfun/step-3.7-flash:free",
        "dots-studio/dots-3-note-preview:free",
        "thinkingmachines/inkling:free"
      ]
    },
    "opencode": {
      "whitelist": [
        "big-pickle",
        "muse-spark-1.3-contributor-free",
        "muse-spark-1.2-contributor-free",
        "muse-spark-1.3-free",
        "muse-spark-1.2-free",
        "nemotron-3.5-lightning-free",
        "nemotron-3-ultra-free",
        "ling-3.0-flash-fin-free",
        "mimo-v2.5-free"
      ]
    },
    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "groq",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1"
      },
      "whitelist": [
        "openai/gpt-oss-120b",
        "openai/gpt-oss-20b",
        "openai/gpt-oss-safeguard-20b",
        "qwen/qwen3.6-27b",
        "qwen/qwen3.8-27b"
      ],
      "models": {
        "llama-3.3-70b-versatile": {
          "name": "llama-3.3-70b-versatile"
        }
      }
    },
    "mistral": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mistral Codestral",
      "options": {
        "baseURL": "https://api.mistral.ai/v1",
        "apiKey": "{env:MISTRAL_API_KEY}"
      },
      "whitelist": [
        "codestral-latest",
        "codestral-2508"
      ]
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (free & deals)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "whitelist": [
        "google/gemma-4-31b-it:free",
        "google/gemma-4-26b-a4b-it:free",
        "stealth/union-alpha",
        "inclusionai/ling-3.0-flash-vl:free",
        "nex-agi/nex-n2.5-mini:free",
        "nex-agi/nex-n2.5-pro:free",
        "inclusionai/ling-3.0-flash-sante:free",
        "inclusionai/ling-3.0-flash-fin:free",
        "dots-studio/dots-3-note-preview:free",
        "liquid/lfm-2.5-2.6b:free",
        "nvidia/nemotron-3.5-lightning:free",
        "thinkingmachines/inkling-small:free",
        "poolside/laguna-s-2.1:free",
        "thinkingmachines/inkling:free",
        "poolside/laguna-xs-2.1:free",
        "cohere/north-mini-code:free",
        "z-ai/glm-5.2:free",
        "nvidia/nemotron-3.5-content-safety:free",
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
        "nvidia/nemotron-3-super-120b-a12b:free",
        "openrouter/free",
        "deepseek/deepseek-v4-flash-0731:free",
        "qwen/qwen3.8-27b:free"
      ],
      "models": {
        "google/gemma-4-31b-it:free": {
          "name": "Google Gemma 4 31B (free)"
        },
        "google/gemma-4-26b-a4b-it:free": {
          "name": "Google Gemma 4 26B (free)"
        },
        "stealth/union-alpha": {
          "name": "Union Alpha (free)"
        },
        "inclusionai/ling-3.0-flash-vl:free": {
          "name": "Ling 3.0 Flash VL (free)"
        },
        "nex-agi/nex-n2.5-mini:free": {
          "name": "Nex-N2.5-Mini (free)"
        },
        "nex-agi/nex-n2.5-pro:free": {
          "name": "Nex-N2.5-Pro (free)"
        },
        "inclusionai/ling-3.0-flash-sante:free": {
          "name": "Ling 3.0 Flash Sante (free)"
        },
        "inclusionai/ling-3.0-flash-fin:free": {
          "name": "Ling 3.0 Flash Fin (free)"
        },
        "dots-studio/dots-3-note-preview:free": {
          "name": "Dots3-Note Preview (free)"
        },
        "liquid/lfm-2.5-2.6b:free": {
          "name": "Liquid LFM 2.5 (free)"
        },
        "nvidia/nemotron-3.5-lightning:free": {
          "name": "Nemotron 3.5 Lightning (free)"
        },
        "thinkingmachines/inkling-small:free": {
          "name": "Inkling Small (free)"
        },
        "poolside/laguna-s-2.1:free": {
          "name": "Poolside Laguna S 2.1 (free)"
        },
        "thinkingmachines/inkling:free": {
          "name": "ThinkingMachines Inkling (free)"
        },
        "poolside/laguna-xs-2.1:free": {
          "name": "Poolside Laguna XS 2.1 (free)"
        },
        "cohere/north-mini-code:free": {
          "name": "Cohere North Mini Code (free)"
        },
        "z-ai/glm-5.2:free": {
          "name": "GLM 5.2 (free)"
        },
        "nvidia/nemotron-3.5-content-safety:free": {
          "name": "Nemotron 3.5 Content Safety (free)"
        },
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron 3 Ultra 550B (free)"
        },
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free": {
          "name": "Nemotron 3 Nano Omni (free)"
        },
        "nvidia/nemotron-3-super-120b-a12b:free": {
          "name": "Nemotron 3 Super 120B (free)"
        },
        "openrouter/free": {
          "name": "OpenRouter Auto Free"
        },
        "deepseek/deepseek-v4-flash-0731:free": {
          "name": "DeepSeek V4 Flash (free)"
        },
        "qwen/qwen3.8-27b:free": {
          "name": "Qwen 3.8 27B (free)"
        }
      }
    },
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (LAN)",
      "options": {
        "baseURL": "http://192.168.254.140:1234/v1",
        "apiKey": "{env:LMSTUDIO_API_KEY}"
      },
      "whitelist": [
        "deepseek-r1-distill-qwen-1.5b",
        "qwen3.5-0.8b"
      ],
      "models": {
        "deepseek-r1-distill-qwen-1.5b": {
          "name": "DeepSeek R1 Distill Qwen 1.5B"
        },
        "qwen3.5-0.8b": {
          "name": "Qwen 3.5 0.8B"
        }
      }
    }
  },
  "disabled_providers": [
    "groq"
  ],
  "agent": {
    "build": {
      "mode": "all",
      "model": "gemini/gemini-3.6-flash",
      "description": "Primary Direct Builder. Solves problems directly and writes clean code immediately without unnecessary delegation.",
      "prompt": "You are the Primary OpenCode Engineering Assistant. Execute tasks directly and efficiently. Write clean, production-ready code immediately in the current thread. NEVER spawn unnecessary subagents. Do NOT run unit tests or lint checks unless explicitly asked by the user."
    },
    "explore": {
      "mode": "all",
      "model": "kilo/inclusionai/ling-3.0-flash-fin:free",
      "description": "Fast codebase explorer and file search specialist.",
      "prompt": "You are the codebase exploration specialist. Locate files, grep patterns, and inspect structures with maximum speed and minimal verbosity."
    },
    "plan": {
      "mode": "all",
      "model": "kilo/nvidia/nemotron-3-ultra-550b-a55b:free",
      "description": "High-capacity reasoning and architectural planning specialist.",
      "prompt": "You are the Strategic Planning Specialist. Design step-by-step implementation plans and verify dependencies before coding starts."
    },
    "coder": {
      "mode": "all",
      "model": "gemini/gemini-3.6-flash",
      "description": "Direct code generation and refactoring specialist.",
      "prompt": "You are a senior developer. Write clean, exact, production-ready code. No placeholders. Execute requests directly."
    },
    "general": {
      "mode": "all",
      "model": "gemini/gemini-3.6-flash",
      "description": "General conversational and troubleshooting assistant.",
      "prompt": "You are a versatile engineering assistant. Provide direct, factual, and actionable solutions."
    },
    "compaction": {
      "mode": "all",
      "model": "gemini/gemini-3.6-flash",
      "description": "Context summarizer and session compaction engine."
    }
  },
  "plugin": [
    "@smart-coders-hq/opencode-model-fallback"
  ]
}